@sops_app.command("rotate")
def rotate_sops_key():
    """Generate a new local Age key, add it to SOPS, re-encrypt ledger, and revoke old local key."""
    old_local_pub = get_local_age_pubkey()
    if not old_local_pub:
        console.print("[bold red]Error: No active local Age key found to rotate.[/bold red]")
        raise typer.Exit(1)

    console.print(f"[bold cyan]Current local Age key:[bold cyan] {old_local_pub}")

    age_dir = Path.home() / ".config" / "sops" / "age"
    key_file = age_dir / "keys.txt"
    new_key_file = age_dir / "keys.txt.new"

    new_pubkey = None
    try:
        res = subprocess.run(
            ["age-keygen", "-o", str(new_key_file)],
            capture_output=True, text=True, check=True,
            env=GitEncryptedLedger._get_env()
        )
        for line in res.stderr.splitlines():
            if "Public key:" in line:
                new_pubkey = line.split(":")[-1].strip()
                break
    except Exception as e:
        console.print(f"[bold red]Failed to generate new Age key:[bold red] {e}")
        if new_key_file.exists():
            new_key_file.unlink()
        raise typer.Exit(1)

    if not new_pubkey:
        console.print("[bold red]Error parsing generated Age public key.[/bold red]")
        if new_key_file.exists():
            new_key_file.unlink()
        raise typer.Exit(1)

    console.print(f"[bold green]✔ Generated new local Age key:[bold green] {new_pubkey}")

    add_sops_key(new_pubkey)

    new_key_file.replace(key_file)
    console.print("[dim green]✔ Activated new key in ~/.config/sops/age/keys.txt[/dim green]")

    sops_config = REPO_DIR / ".sops.yaml"
    with open(sops_config, "r") as f:
        config_data = yaml.safe_load(f) or {}

    rules = config_data.get("creation_rules", [{}])[0]
    existing_age = rules.get("age", [])

    if old_local_pub in existing_age:
        existing_age.remove(old_local_pub)
        rules["age"] = existing_age
        config_data["creation_rules"] = [rules]

        with open(sops_config, "w") as f:
            yaml.dump(config_data, f, default_flow_style=False)

        if LEDGER_PATH.exists():
            subprocess.run(
                ["sops", "updatekeys", "-y", str(LEDGER_PATH)],
                cwd=REPO_DIR, check=True, capture_output=True,
                env=GitEncryptedLedger._get_env()
            )

        if (REPO_DIR / ".git").exists():
            env = GitEncryptedLedger._get_env()
            subprocess.run(["git", "add", ".sops.yaml"], cwd=REPO_DIR, check=True, env=env)
            if LEDGER_PATH.exists():
                subprocess.run(["git", "add", str(LEDGER_PATH)], cwd=REPO_DIR, check=True, env=env)

            subprocess.run(["git", "commit", "-m", f"Rotate local SOPS key to {new_pubkey[:12]}"], cwd=REPO_DIR, check=True, env=env)
            subprocess.run(["git", "push", "origin", "main"], cwd=REPO_DIR, check=True, env=env)

    console.print(f"[bold green]✔ Successfully rotated local Age key to {new_pubkey[:15]}...[/bold green]")

@sops_app.command("revoke")
def revoke_sops_key(
    age_pubkey: str = typer.Argument(..., help="Age recipient public key to remove (starts with age1...)")
):
    """Remove an Age recipient public key from SOPS configuration and re-encrypt the ledger."""
    sops_config = REPO_DIR / ".sops.yaml"
    if not sops_config.exists():
        console.print("[bold red]Error: .sops.yaml missing. Run 'hwkey init' first.[/bold red]")
        raise typer.Exit(1)

    clean_key = age_pubkey.strip()

    local_pub = get_local_age_pubkey()
    if local_pub and clean_key == local_pub:
        console.print("[bold red]Security Guard triggered: You cannot revoke the active local key for this workstation![/bold red]")
        console.print("[yellow]To replace this key, use 'hwkey sops rotate' instead.[/yellow]")
        raise typer.Exit(1)

    with open(sops_config, "r") as f:
        config_data = yaml.safe_load(f) or {}

    rules = config_data.get("creation_rules", [{}])[0]
    existing_age = rules.get("age", [])

    if isinstance(existing_age, str):
        existing_age = [k.strip() for k in existing_age.split(",") if k.strip()]

    if clean_key not in existing_age:
        console.print(f"[bold red]Key '{clean_key[:15]}...' not found in .sops.yaml recipient list.[/bold red]")
        raise typer.Exit(1)

    if len(existing_age) <= 1:
        console.print("[bold red]Cannot revoke key: At least one SOPS recipient key must remain configured![/bold red]")
        raise typer.Exit(1)

    existing_age.remove(clean_key)
    rules["age"] = existing_age
    config_data["creation_rules"] = [rules]

    with open(sops_config, "w") as f:
        yaml.dump(config_data, f, default_flow_style=False)

    console.print(f"[bold green]✔ Removed recipient {clean_key[:15]}... from .sops.yaml[/bold green]")

    if LEDGER_PATH.exists():
        try:
            res = subprocess.run(
                ["sops", "updatekeys", "-y", str(LEDGER_PATH)],
                cwd=REPO_DIR,
                capture_output=True,
                text=True,
                env=GitEncryptedLedger._get_env()
            )
            if res.returncode != 0:
                console.print(f"[bold red]SOPS updatekeys failed:[bold red] {res.stderr.strip()}")
                raise typer.Exit(1)

            console.print("[dim green]✔ Re-encrypted ledger.enc.yaml with updated recipient list.[/dim green]")
        except Exception as e:
            console.print(f"[bold red]Failed to update SOPS keys:[bold red] {e}")
            raise typer.Exit(1)

    if (REPO_DIR / ".git").exists():
        try:
            env = GitEncryptedLedger._get_env()
            subprocess.run(["git", "add", ".sops.yaml"], cwd=REPO_DIR, check=True, env=env)
            if LEDGER_PATH.exists():
                subprocess.run(["git", "add", str(LEDGER_PATH)], cwd=REPO_DIR, check=True, env=env)

            subprocess.run(["git", "commit", "-m", f"Revoke SOPS recipient {clean_key[:12]}"], cwd=REPO_DIR, check=True, env=env)
            subprocess.run(["git", "push", "origin", "main"], cwd=REPO_DIR, check=True, env=env)
            console.print("[dim green]✔ Committed and pushed SOPS configuration to remote Git.[/dim green]")
        except Exception as e:
            console.print(f"[dim yellow]Notice: Git push skipped/failed: {e}[/dim yellow]")

