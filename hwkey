def ensure_sops_config() -> List[str]:
    """Ensures a local Age key exists and writes a valid .sops.yaml file."""
    age_dir = Path.home() / ".config" / "sops" / "age"
    age_dir.mkdir(parents=True, exist_ok=True)
    key_file = age_dir / "keys.txt"
    recipients: List[str] = []

    if key_file.exists():
        with open(key_file, "r") as f:
            for line in f:
                if line.startswith("# public key:"):
                    pub = line.split(":")[-1].strip()
                    recipients.append(pub)
                    break

    if not recipients:
        console.print("[bold cyan]Generating local Age encryption key...[/bold cyan]")
        try:
            res = subprocess.run(
                ["age-keygen", "-o", str(key_file)],
                capture_output=True, text=True, check=True,
                env={"PATH": ENV_PATH}
            )
            for line in res.stderr.splitlines():
                if "Public key:" in line:
                    pub = line.split(":")[-1].strip()
                    recipients.append(pub)
                    console.print(f"[bold green]✔ Generated software Age key: {pub}[/bold green]")
        except (subprocess.CalledProcessError, FileNotFoundError):
            console.print("[bold red]Error: 'age-keygen' tool not found. Run ./install.sh first.[/bold red]")
            raise typer.Exit(1)

    age_list_formatted = "\n".join([f"      - {r}" for r in recipients])
    sops_content = f"creation_rules:\n  - path_regex: ledger\\.enc\\.yaml$\n    age:\n{age_list_formatted}\n"

    sops_config = REPO_DIR / ".sops.yaml"
    REPO_DIR.mkdir(parents=True, exist_ok=True)
    with open(sops_config, "w") as f:
        f.write(sops_content)

    return recipients

@app.command()
def init(
    git_url: Optional[str] = typer.Option(None, "--git-url", "-g", help="Remote Git repository URL")
):
    """Initialize the local ledger repository, provision Age keys, and configure SOPS encryption."""
    recipients = ensure_sops_config()

    if typer.confirm("Would you like to add a SECOND Age public key recipient for backup?", default=False):
        backup_pub = typer.prompt("Enter backup Age public key (starts with age1...)").strip()
        recipients.append(backup_pub)
        
        age_list_formatted = "\n".join([f"      - {r}" for r in recipients])
        sops_content = f"creation_rules:\n  - path_regex: ledger\\.enc\\.yaml$\n    age:\n{age_list_formatted}\n"
        with open(REPO_DIR / ".sops.yaml", "w") as f:
            f.write(sops_content)

    if not (REPO_DIR / ".git").exists():
        subprocess.run(["git", "init", "-b", "main"], cwd=REPO_DIR, check=True, env={"PATH": ENV_PATH})
        console.print("[bold green]✔ Initialized local Git repository.[/bold green]")

    console.print(f"[bold green]✔ Configured SOPS encryption with {len(recipients)} recipient key(s).[/bold green]")

    if git_url:
        set_remote(git_url)

@app.command("set-remote")
def set_remote(
    git_url: str = typer.Argument(..., help="Remote Git URL (e.g. git@github.com:user/hwkey-ledger.git)")
):
    """Configure or update the remote Git repository URL."""
    if not (REPO_DIR / ".git").exists():
        subprocess.run(["git", "init", "-b", "main"], cwd=REPO_DIR, check=True, env={"PATH": ENV_PATH})

    res = subprocess.run(["git", "remote", "get-url", "origin"], cwd=REPO_DIR, capture_output=True, text=True, env={"PATH": ENV_PATH})
    if res.returncode == 0:
        subprocess.run(["git", "remote", "set-url", "origin", git_url], cwd=REPO_DIR, check=True, env={"PATH": ENV_PATH})
    else:
        subprocess.run(["git", "remote", "add", "origin", git_url], cwd=REPO_DIR, check=True, env={"PATH": ENV_PATH})

    console.print(f"[bold green]✔ Git remote 'origin' set to: {git_url}[/bold green]")

