@app.command()
def init(
    git_url: Optional[str] = typer.Option(None, "--git-url", "-g", help="Remote Git repository URL")
):
    """Initialize local ledger repository, provision Age keys, and configure SOPS encryption."""
    recipients = ensure_sops_config()

    if typer.confirm("Would you like to add a SECOND Age public key recipient for backup?", default=False):
        backup_pub = typer.prompt("Enter backup Age public key (starts with age1...)").strip()
        recipients.append(backup_pub)
        
        age_list_formatted = "\n".join([f"      - {r}" for r in recipients])
        sops_content = f"creation_rules:\n  - path_regex: ledger\\.enc\\.yaml$\n    age:\n{age_list_formatted}\n"
        with open(REPO_DIR / ".sops.yaml", "w") as f:
            f.write(sops_content)

    if not (REPO_DIR / ".git").exists():
        subprocess.run(["git", "init", "-b", "main"], cwd=REPO_DIR, check=True, env=GitEncryptedLedger._get_env())
        console.print("[bold green]✔ Initialized local Git repository.[/bold green]")

    console.print(f"[bold green]✔ Configured SOPS encryption with {len(recipients)} recipient key(s).[/bold green]")

    if git_url:
        set_git_remote(git_url)

@app.command()
def ssh(
    target: str = typer.Argument(..., help="Destination host, alias, or user@host"),
    key: Optional[str] = typer.Option(None, "--key", "-k", "-i", help="Specific hardware key alias from ledger to use"),
    user: Optional[str] = typer.Option(None, "--user", "-u", help="Remote SSH user override"),
    port: Optional[int] = typer.Option(None, "--port", "-p", help="SSH port override"),
    command: Optional[List[str]] = typer.Argument(None, help="Optional remote command to execute")
):
    """Connect to a target server using an enrolled hardware key."""
    ledger = load_ledger()
    hosts = ledger.get("hosts", [])

    resolved_user = user
    resolved_hostname = target
    resolved_port = port

    if "@" in target:
        inline_user, resolved_hostname = target.split("@", 1)
        if not resolved_user:
            resolved_user = inline_user

    matching_host = None
    for h in hosts:
        if h.get("alias") == resolved_hostname or h.get("hostname") == resolved_hostname:
            if user and h.get("user") != user:
                continue
            matching_host = h
            break

    if matching_host:
        resolved_hostname = matching_host["hostname"]
        if not resolved_user:
            resolved_user = matching_host.get("user")
        if not resolved_port:
            resolved_port = matching_host.get("port", 22)

    destination = f"{resolved_user}@{resolved_hostname}" if resolved_user else resolved_hostname
    console.print(f"[bold blue]Connecting to {destination} using YubiKey...[/bold blue]")

    with tempfile.TemporaryDirectory() as tmpdir:
        try:
            subprocess.run(
                ["ssh-keygen", "-K", "-N", ""],
                cwd=tmpdir,
                capture_output=True,
                text=True,
                check=True,
                env=GitEncryptedLedger._get_env()
            )
        except subprocess.CalledProcessError:
            console.print("[bold red]Error: Failed to read resident keys from hardware key. Is it attached?[/bold red]")
            raise typer.Exit(1)

        pub_files = list(Path(tmpdir).glob("*.pub"))
        if not pub_files:
            console.print("[bold red]No resident SSH keys found on attached hardware token.[/bold red]")
            raise typer.Exit(1)

        identity_file = pub_files[0].with_suffix("")

        if key and key in ledger.get("keys", {}):
            target_pub = ledger["keys"][key]["public_key"].strip()
            found = False
            for pub_path in pub_files:
                with open(pub_path, "r") as f:
                    if target_pub in f.read().strip():
                        identity_file = pub_path.with_suffix("")
                        found = True
                        break
            if not found:
                console.print(f"[bold yellow]Notice: Key '{key}' not found on attached device. Using default resident key.[/bold yellow]")

        cmd_args = ["ssh", "-i", str(identity_file)]
        if resolved_port:
            cmd_args.extend(["-p", str(resolved_port)])

        cmd_args.append(destination)
        if command:
            cmd_args.extend(command)

        env = GitEncryptedLedger._get_env()
        try:
            os.execvpe("ssh", cmd_args, env)
        except Exception as e:
            console.print(f"[bold red]Failed to execute SSH process:[bold red] {e}")
            raise typer.Exit(1)

