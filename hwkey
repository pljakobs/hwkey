@host_app.command("remove")
def remove_host(
    alias_or_host: str = typer.Argument(..., help="Host alias or hostname to remove"),
    user: Optional[str] = typer.Option(None, "--user", "-u", help="Specific user entry to target if multiple exist")
):
    """Remove a target host entry from the encrypted ledger."""
    ledger = load_ledger()
    hosts = ledger.get("hosts", [])
    
    matching_hosts = [
        h for h in hosts 
        if (h.get("alias") == alias_or_host or h.get("hostname") == alias_or_host)
        and (user is None or h.get("user") == user)
    ]

    if not matching_hosts:
        console.print(f"[bold red]Host entry '{alias_or_host}' not found in ledger.[/bold red]")
        raise typer.Exit(1)

    ledger["hosts"] = [h for h in hosts if h not in matching_hosts]
    save_ledger(ledger, action=f"Remove host {alias_or_host}")
    console.print(f"[bold green]✔ Successfully removed host '{alias_or_host}' from ledger.[/bold green]")

