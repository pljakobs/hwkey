        except Exception as e:
            console.print(f"[bold red]Failed to update SOPS keys:[bold red] {e}")
            raise typer.Exit(1)

    if (REPO_DIR / ".git").exists():
        try:
            env = GitEncryptedLedger._get_env()
            subprocess.run(["git", "add", ".sops.yaml"], cwd=REPO_DIR, check=True, env=env)
            if LEDGER_PATH.exists():
                subprocess.run(["git", "add", str(LEDGER_PATH)], cwd=REPO_DIR, check=True, env=env)

