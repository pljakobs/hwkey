@key_app.command("add")
def register_key(
    key_id: str = typer.Argument(..., help="Identifier for the key (e.g. yubi_primary)"),
    pubkey: str = typer.Argument(..., help="The SSH public key string"),
    auth_key: Optional[str] = typer.Option(None, "--auth-key", "-A", help="Existing deployed ledger key ID to authenticate rollout")
):
    """Manually register an existing hardware SSH key into the ledger."""
    ledger = load_ledger()
    clean_pubkey = pubkey.strip()
    ledger["keys"][key_id] = {"public_key": clean_pubkey}
    failed_hosts = deploy_keys_to_registered_hosts(ledger, [(key_id, clean_pubkey)], auth_key_id=auth_key)
    save_ledger(ledger, action=f"Register key {key_id}")
    if failed_hosts:
        console.print(f"[bold yellow]Registered key, but could not deploy it to: {', '.join(failed_hosts)}[/bold yellow]")
    console.print(f"[bold green]Registered hardware key '{key_id}' into encrypted ledger.[/bold green]")

@key_app.command("enroll")
def enroll_key(
    key_id: str = typer.Option(None, "--id", "-i", help="Unique ledger identifier for the new key"),
    application: str = typer.Option("hwkey", "--application", "-a", help="Key comment/application tag"),
    auth_key: Optional[str] = typer.Option(None, "--auth-key", "-A", help="Existing deployed ledger key ID to authenticate rollout")
):

    ensure_yubikey_pin()

    """Generate a brand-new resident SSH key on the physical YubiKey and record it in the ledger."""
    console.print("[bold blue]Generating new resident credential on physical token...[/bold blue]")

    alias = key_id or typer.prompt("Enter a unique identifier for this new key (e.g., yubi_primary)")

    ledger = load_ledger()
    if alias in ledger.get("keys", {}):
        console.print(f"[bold red]Key ID '{alias}' already exists in ledger. Use 'key rotate' or choose another ID.[/bold red]")
        raise typer.Exit(1)

    with tempfile.TemporaryDirectory() as tmpdir:
        key_path = Path(tmpdir) / "id_ed25519_sk"
        try:
            subprocess.run([
                "ssh-keygen", "-t", "ed25519-sk",
                "-O", "resident",
                "-O", "verify-required",
                "-N", "",
                "-C", f"{alias} ({application})",
                "-f", str(key_path)
            ], check=True, env=GitEncryptedLedger._get_env())

            with open(Path(str(key_path) + ".pub"), "r") as f:
                pubkey = f.read().strip()

        except subprocess.CalledProcessError:
            console.print("[bold red]Failed to create resident key on hardware device. Ensure key is connected and PIN/touch is supplied.[/bold red]")
            raise typer.Exit(1)

    ledger["keys"][alias] = {"public_key": pubkey}
    failed_hosts = deploy_keys_to_registered_hosts(ledger, [(alias, pubkey)], auth_key_id=auth_key)
    save_ledger(ledger, action=f"Enroll resident key {alias}")
    if failed_hosts:
        console.print(f"[bold yellow]Created and registered key, but could not deploy it to: {', '.join(failed_hosts)}[/bold yellow]")
    console.print(f"[bold green]✔ Successfully created resident key on hardware and registered '{alias}' in ledger![/bold green]")

@key_app.command("stub")
def generate_stubs(
    output_dir: Path = typer.Option(
        Path.home() / ".ssh", "--out-dir", "-o", help="Directory where SSH key stubs should be generated"
    )
):
    """Extract resident key handles from the attached hardware key into local SSH stubs."""
    console.print(f"[bold blue]Extracting local key handles from attached YubiKey into {output_dir}...[/bold blue]")
    output_dir.mkdir(parents=True, exist_ok=True)

    try:
        res = subprocess.run(
            ["ssh-keygen", "-K"],
            cwd=output_dir,
            capture_output=True,
            text=True,
            check=True,
            env=GitEncryptedLedger._get_env()
        )

        extracted_files = list(output_dir.glob("id_*_rk*"))
        if not extracted_files:
            console.print("[bold yellow]No resident keys found on the attached token.[/bold yellow]")
            return

        console.print(f"[bold green]✔ Extracted key stub(s) successfully:[/bold green]")
        for stub in output_dir.glob("id_*_rk*.pub"):
            console.print(f"  • {stub.with_suffix('').name} ({stub.name})")

    except subprocess.CalledProcessError as e:
        console.print(f"[bold red]Failed to extract resident keys: {e.stderr.strip()}[/bold red]")
        raise typer.Exit(1)

@key_app.command("scan")
def scan_keys(
    auth_key: Optional[str] = typer.Option(None, "--auth-key", "-A", help="Existing deployed ledger key ID to authenticate rollout")
):
    """Scan attached YubiKeys, check registration status in ledger, and sync hardware resident keys."""
    console.print("[bold blue]Scanning USB bus for physical hardware keys...[/bold blue]")

    serials = []
    try:
        res = subprocess.run(
            ["ykman", "list", "--serials"],
            capture_output=True, text=True, check=True,
            env=GitEncryptedLedger._get_env()
        )
        serials = [s.strip() for s in res.stdout.splitlines() if s.strip()]
    except (subprocess.CalledProcessError, FileNotFoundError):
        pass

    devices = []
    for dev in CtapHidDevice.list_devices():
        desc = getattr(dev, "descriptor", dev)
        product_name = getattr(desc, "product_name", "Security Key")
        vid = getattr(desc, "vid", getattr(dev, "vid", 0))
        pid = getattr(desc, "pid", getattr(dev, "pid", 0))
        path = getattr(dev, "path", getattr(desc, "path", "unknown"))

        if any(name.lower() in str(product_name).lower() for name in ["yubikey", "security key"]):
            devices.append({
                "product_name": product_name,
                "vendor_id": hex(vid) if isinstance(vid, int) else str(vid),
                "product_id": hex(pid) if isinstance(pid, int) else str(pid),
                "path": str(path)
            })

    if not devices:
        console.print("[bold red]No physical FIDO2 USB devices found![/bold red]")
        return

    console.print(f"[bold cyan]Found {len(devices)} physical hardware key device(s):[/bold cyan]")
    
    ledger = load_ledger()

    for idx, dev in enumerate(devices):
        dev_serial = serials[idx] if idx < len(serials) else None
        serial_display = f" [dim](Serial: {dev_serial})[/dim]" if dev_serial else ""
        console.print(f"  • {dev['product_name']}{serial_display} (VID: {dev['vendor_id']} PID: {dev['product_id']})")
        
        # Talk specifically to this key index/serial for PIN validation
        ensure_yubikey_pin(dev_serial)

    discovered_keys = []
    with tempfile.TemporaryDirectory() as tmpdir:
        try:
            subprocess.run(
                ["ssh-keygen", "-K", "-N", ""],
                cwd=tmpdir,
                capture_output=True,
                text=True,
                check=True,
                env=GitEncryptedLedger._get_env()
            )
            for key_file in Path(tmpdir).glob("*.pub"):
                with open(key_file, "r") as f:
                    discovered_keys.append({
                        "file_name": key_file.name,
                        "public_key": f.read().strip()
                    })
        except subprocess.CalledProcessError:
            console.print("[bold yellow]Note: 'ssh-keygen -K' found no pre-existing resident keys on tokens.[/bold yellow]")

    if not discovered_keys:
        console.print("[dim yellow]No resident keys to sync. Use 'hwkey key enroll' if you wish to provision a new key.[/dim yellow]")
        return

    updated = False
    keys_to_deploy = []

    for item in discovered_keys:
        pub = item["public_key"]
        pub_identity = public_key_identity(pub)
        existing_alias = next(
            (k for k, v in ledger.get("keys", {}).items() if public_key_identity(v.get("public_key", "")) == pub_identity),
            None
        )

        if existing_alias:
            console.print(f"[dim green]  ✔ Resident key already registered in ledger under alias: '{existing_alias}'[/dim green]")
        else:
            auto_alias = typer.prompt(f"Found unregistered resident key ({pub[:15]}...). Enter alias", default=f"yubi_key_{len(ledger.get('keys', {})) + 1}")
            ledger["keys"][auto_alias] = {"public_key": pub}
            console.print(f"[bold green]✔ Enrolled '{auto_alias}' into ledger[/bold green]")
            keys_to_deploy.append((auto_alias, pub))
            updated = True

    if updated:
        failed_hosts = deploy_keys_to_registered_hosts(ledger, keys_to_deploy, auth_key_id=auth_key)
        save_ledger(ledger, action="Scan & sync attached hardware keys")
        if failed_hosts:
            console.print(f"[bold yellow]Synced keys, but could not deploy them to: {', '.join(failed_hosts)}[/bold yellow]")

@key_app.command("verify")
def verify_attached_keys():
    """Verify attached resident SSH keys against the encrypted ledger."""
    ledger = load_ledger()
    ledger_keys = ledger.get("keys", {})
    ledger_by_identity = {
        public_key_identity(key_info.get("public_key", "")): key_alias
        for key_alias, key_info in ledger_keys.items()
        if key_info.get("public_key")
    }

    serials = []
    try:
        res = subprocess.run(
            ["ykman", "list", "--serials"],
            capture_output=True, text=True, check=True,
            env=GitEncryptedLedger._get_env()
        )
        serials = [s.strip() for s in res.stdout.splitlines() if s.strip()]
    except (subprocess.CalledProcessError, FileNotFoundError):
        pass

    devices = list(CtapHidDevice.list_devices())
    console.print(f"[bold cyan]Detected {len(devices)} FIDO2 device(s) and {len(serials)} YubiKey serial(s).[/bold cyan]")

    try:
        attached_keys = read_attached_resident_keys()
    except RuntimeError as e:
        console.print(f"[bold red]Could not read resident SSH keys from attached token(s): {e}[/bold red]")
        raise typer.Exit(1)

    attached_by_identity = {item["identity"]: item for item in attached_keys}

    table = Table(title="Attached Hardware Key Verification")
    table.add_column("Ledger Alias", style="cyan")
    table.add_column("Token Status", style="magenta")
    table.add_column("Deployment Status", style="green")
    table.add_column("Hosts", style="yellow")

    for key_alias, key_info in ledger_keys.items():
        identity = public_key_identity(key_info.get("public_key", ""))
        token_status = "[green]present[/green]" if identity in attached_by_identity else "[red]missing[/red]"
        deployed_hosts = [
            f"{host.get('user')}@{host.get('alias', host.get('hostname'))}"
            for host in ledger.get("hosts", [])
            if key_alias in host.get("deployed_keys", [])
        ]
        host_count = len(ledger.get("hosts", []))
        deployment_status = f"{len(deployed_hosts)}/{host_count} hosts" if host_count else "no hosts"
        table.add_row(
            key_alias,
            token_status,
            deployment_status,
            ", ".join(deployed_hosts) if deployed_hosts else "None"
        )

    console.print(table)

    unregistered = [
        item for item in attached_keys
        if item["identity"] not in ledger_by_identity
    ]
    if unregistered:
        extra_table = Table(title="Resident Keys Not Registered In Ledger")
        extra_table.add_column("Extracted Stub", style="cyan")
        extra_table.add_column("Public Key Excerpt", style="magenta")
        for item in unregistered:
            pubkey = item["public_key"]
            excerpt = f"{pubkey[:30]}...{pubkey[-20:]}" if len(pubkey) > 55 else pubkey
            extra_table.add_row(item["file_name"], excerpt)
        console.print(extra_table)

    if not attached_keys:
        console.print("[bold yellow]No resident SSH keys were found on attached hardware token(s).[/bold yellow]")

