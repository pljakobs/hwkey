@git_app.command("set-remote")
def set_git_remote(
    git_url: str = typer.Argument(..., help="Remote Git URL (e.g. git@github.com:user/hwkey-ledger.git)")
):
    """Configure or update the remote Git repository URL for the ledger."""
    if not (REPO_DIR / ".git").exists():
        subprocess.run(["git", "init", "-b", "main"], cwd=REPO_DIR, check=True, env=GitEncryptedLedger._get_env())

    res = subprocess.run(["git", "remote", "get-url", "origin"], cwd=REPO_DIR, capture_output=True, text=True, env=GitEncryptedLedger._get_env())
    if res.returncode == 0:
        subprocess.run(["git", "remote", "set-url", "origin", git_url], cwd=REPO_DIR, check=True, env=GitEncryptedLedger._get_env())
    else:
        subprocess.run(["git", "remote", "add", "origin", git_url], cwd=REPO_DIR, check=True, env=GitEncryptedLedger._get_env())

    console.print(f"[bold green]✔ Git remote 'origin' set to: {git_url}[/bold green]")

@git_app.command("show-remotes")
def show_git_remotes():
    """Show registered Git remotes configured for the ledger."""
    if not (REPO_DIR / ".git").exists():
        console.print("[bold yellow]No local Git repository initialized.[/bold yellow]")
        return

    res = subprocess.run(["git", "remote", "-v"], cwd=REPO_DIR, capture_output=True, text=True, env=GitEncryptedLedger._get_env())
    if res.returncode != 0 or not res.stdout.strip():
        console.print("[bold yellow]No Git remotes configured.[/bold yellow]")
