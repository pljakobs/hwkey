@host_app.command("add")
def register_host(
    hostname: str = typer.Argument(..., help="IP or FQDN of host"),
    alias: Optional[str] = typer.Option(None, "--alias", "-a", help="Optional alias for the host"),
    user: str = typer.Option(os.getlogin(), "--user", "-u", help="Remote SSH user"),
    port: int = typer.Option(22, "--port", "-p", help="SSH port")
):
    """Register a target server host entry and deploy all active hardware keys to it."""
    ledger = load_ledger()
    if not ledger.get("keys"):
        console.print("[bold red]No hardware keys registered in ledger yet! Run 'key scan' or 'key add' first.[/bold red]")
        raise typer.Exit(1)

    host_alias = alias if alias else hostname
    host_info = {
        "alias": host_alias,
        "hostname": hostname,
        "user": user,
        "port": port,
        "deployed_keys": list(ledger["keys"].keys())
    }
    keys_to_deploy = [(k_alias, k_info["public_key"]) for k_alias, k_info in ledger["keys"].items()]

    success = update_remote_authorized_keys(host_info, keys_to_add=keys_to_deploy, keys_to_remove_aliases=[])
    
    if success:
        hosts = ledger.setdefault("hosts", [])
        ledger["hosts"] = [h for h in hosts if not (h.get("alias") == host_alias and h.get("user") == user)]
        ledger["hosts"].append(host_info)
        save_ledger(ledger, action=f"Register host {user}@{host_alias}")

@host_app.command("scan")
def scan_host_keys(
    alias_or_host: str = typer.Argument(..., help="Host alias or hostname to inspect for state drift")
):
    """Inspect a remote target server's authorized_keys to detect managed vs unmanaged key drift."""
    ledger = load_ledger()
    hosts = ledger.get("hosts", [])
    
    matching_host = next(
        (h for h in hosts if h.get("alias") == alias_or_host or h.get("hostname") == alias_or_host), 
        None
    )

    if not matching_host:
        console.print(f"[bold red]Host entry '{alias_or_host}' not found in ledger.[/bold red]")
        raise typer.Exit(1)

    hostname = matching_host["hostname"]
    port = matching_host.get("port", 22)
    user = matching_host.get("user", os.getlogin())

    client = paramiko.SSHClient()
    client.set_missing_host_key_policy(paramiko.AutoAddPolicy())

    try:
        console.print(f"[bold blue]Connecting to {user}@{hostname}:{port}...[/bold blue]")
        client.connect(hostname=hostname, port=port, username=user, timeout=10)
        sftp = client.open_sftp()

        auth_keys_path = ".ssh/authorized_keys"
        existing_lines = []
        with sftp.open(auth_keys_path, "r") as f:
            existing_lines = [line.strip() for line in f.readlines() if line.strip()]

        sftp.close()
        client.close()

        table = Table(title=f"Remote State Inspection: {user}@{hostname}")
        table.add_column("Key Line Excerpt", style="cyan")
        table.add_column("Management Status", style="magenta")
        table.add_column("hwkey Tag Alias", style="green")

        for line in existing_lines:
            raw_line, managed_alias = parse_authorized_keys_line(line)
            excerpt = f"{raw_line[:30]}...{raw_line[-15:]}" if len(raw_line) > 45 else raw_line
            
            if managed_alias:
                status = "[green]Managed by hwkey[/green]"
            else:
                status = "[yellow]Unmanaged (Out-of-Band)[/yellow]"

            table.add_row(excerpt, status, managed_alias or "None")

        console.print(table)

    except Exception as e:
        console.print(f"[bold red]✖ Failed to scan target host {hostname}: {e}[/bold red]")

