class GitEncryptedLedger:
    """Handles SOPS encryption/decryption in-memory and Git sync."""

    def __init__(self, repo_dir: Path, ledger_path: Path):
        self.repo_dir = repo_dir
        self.ledger_path = ledger_path

    @staticmethod
    def _get_env() -> dict:
        env = os.environ.copy()
        env["PATH"] = ENV_PATH
        env["HOME"] = str(Path.home())
        return env

    def _run_cmd(self, cmd: list, cwd: Optional[Path] = None, capture: bool = True) -> str:
        res = subprocess.run(
            cmd,
            cwd=cwd or self.repo_dir,
            capture_output=capture,
            text=True,
            env=self._get_env()
        )
        if res.returncode != 0:
            raise RuntimeError(f"Command {' '.join(cmd)} failed: {res.stderr.strip()}")
        return res.stdout

    def sync_pull(self):
        """Pulls latest encrypted ledger state from remote Git repo if available."""
        if (self.repo_dir / ".git").exists():
            try:
                check_remote = subprocess.run(
                    ["git", "ls-remote", "--heads", "origin", "main"],
                    cwd=self.repo_dir, capture_output=True, text=True, env=self._get_env()
                )
                if check_remote.returncode == 0 and not check_remote.stdout.strip():
                    console.print("[dim cyan]Remote repository is empty. Creating initial commit...[/dim cyan]")
                    self._run_cmd(["git", "checkout", "-b", "main"])
                    self._run_cmd(["git", "commit", "--allow-empty", "-m", "Initial commit"])
                    self._run_cmd(["git", "push", "-u", "origin", "main"])

                self._run_cmd(["git", "pull", "--rebase", "--autostash", "origin", "main"])
            except Exception as e:
                console.print(f"[dim yellow]Notice: Git pull skipped/failed: {e}[/dim yellow]")

    def load(self) -> dict:
        """Decrypts the ledger using SOPS directly into memory."""
        self.sync_pull()
        
        if not self.ledger_path.exists():
            return {"keys": {}, "hosts": []}

        try:
            decrypted_yaml = self._run_cmd(["sops", "-d", str(self.ledger_path)])
            data = yaml.safe_load(decrypted_yaml) or {"keys": {}, "hosts": []}
            
            # Compatibility layer: Ensure hosts internal data structure is a list
            if isinstance(data.get("hosts"), dict):
                migrated_hosts = []
                for alias, hdata in data["hosts"].items():
                    hdata["alias"] = alias
                    migrated_hosts.append(hdata)
                data["hosts"] = migrated_hosts

            return data
        except Exception as e:
            console.print(f"[bold red]SOPS Decryption Error:[bold red] {e}")
            raise typer.Exit(1)

    def save(self, data: dict, commit_msg: str = "Update hwkey ledger"):
        """Encrypts updated ledger in memory, writes to disk, commits, and pushes to Git."""
        self.repo_dir.mkdir(parents=True, exist_ok=True)
        sops_config = self.repo_dir / ".sops.yaml"

        if not sops_config.exists():
            console.print("[bold yellow].sops.yaml missing. Initializing environment...[/bold yellow]")
            ensure_sops_config()

        raw_yaml = yaml.dump(data, default_flow_style=False)

        process = subprocess.Popen(
            ["sops", "--encrypt", "--filename-override", "ledger.enc.yaml", "/dev/stdin"],
            cwd=self.repo_dir,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            env=self._get_env()
        )
        encrypted_out, err = process.communicate(input=raw_yaml)

        if process.returncode != 0:
            console.print(f"[bold red]SOPS Encryption Error:[bold red] {err.strip()}")
            raise typer.Exit(1)

        with open(self.ledger_path, "w") as f:
            f.write(encrypted_out)

        if (self.repo_dir / ".git").exists():
            try:
                self._run_cmd(["git", "add", str(self.ledger_path)])
                self._run_cmd(["git", "add", ".sops.yaml"])
                self._run_cmd(["git", "commit", "-m", commit_msg])
                self._run_cmd(["git", "push", "origin", "main"])
                console.print("[dim green]Synced changes with remote Git repo.[/dim green]")
            except Exception as e:
                console.print(f"[dim yellow]Notice: Git push skipped/failed: {e}[/dim yellow]")

ledger_mgr = GitEncryptedLedger(REPO_DIR, LEDGER_PATH)

def load_ledger() -> dict:
    return ledger_mgr.load()

def save_ledger(data: dict, action: str = "Update hwkey ledger"):
    ledger_mgr.save(data, commit_msg=action)

