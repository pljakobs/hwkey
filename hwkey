    table = Table(title="Git Ledger Remotes")
    table.add_column("Remote Name", style="cyan")
    table.add_column("URL", style="magenta")
    
    for line in res.stdout.splitlines():
        parts = line.split()
        if len(parts) >= 2:
            table.add_row(parts[0], parts[1])

    console.print(table)

