# ----------------------------------------------------------------------
# Encrypted Git Ledger Engine
# ----------------------------------------------------------------------

class GitEncryptedLedger:
    """Handles SOPS encryption/decryption in-memory and Git sync."""

    def __init__(self, repo_dir: Path, ledger_path: Path):
        self.repo_dir = repo_dir
        self.ledger_path = ledger_path

    @staticmethod
    def _get_env() -> dict:
        env = os.environ.copy()
        env["PATH"] = ENV_PATH
        env["HOME"] = str(Path.home())
        return env

    def _run_cmd(self, cmd: list, cwd: Optional[Path] = None, capture: bool = True) -> str:
        res = subprocess.run(
            cmd,
            cwd=cwd or self.repo_dir,
            capture_output=capture,
            text=True,
            env=self._get_env()
        )
        if res.returncode != 0:
            raise RuntimeError(f"Command {' '.join(cmd)} failed: {res.stderr.strip()}")
        return res.stdout

    def sync_pull(self):
        """Pulls latest encrypted ledger state from remote Git repo if available."""
        if (self.repo_dir / ".git").exists():
            try:
                check_remote = subprocess.run(
                    ["git", "ls-remote", "--heads", "origin", "main"],
                    cwd=self.repo_dir, capture_output=True, text=True, env=self._get_env()
                )
                if check_remote.returncode == 0 and not check_remote.stdout.strip():
                    console.print("[dim cyan]Remote repository is empty. Creating initial commit...[/dim cyan]")
                    self._run_cmd(["git", "checkout", "-b", "main"])
                    self._run_cmd(["git", "commit", "--allow-empty", "-m", "Initial commit"])
                    self._run_cmd(["git", "push", "-u", "origin", "main"])

                self._run_cmd(["git", "pull", "--rebase", "--autostash", "origin", "main"])
            except Exception as e:
                console.print(f"[dim yellow]Notice: Git pull skipped/failed: {e}[/dim yellow]")

    def load(self) -> dict:
        """Decrypts the ledger using SOPS directly into memory."""
        self.sync_pull()
        
        if not self.ledger_path.exists():
            return {"keys": {}, "hosts": {}}

        try:
            decrypted_yaml = self._run_cmd(["sops", "-d", str(self.ledger_path)])
            return yaml.safe_load(decrypted_yaml) or {"keys": {}, "hosts": {}}
        except Exception as e:
            console.print(f"[bold red]SOPS Decryption Error:[bold red] {e}")
            raise typer.Exit(1)

    def save(self, data: dict, commit_msg: str = "Update hwkey ledger"):
        """Encrypts updated ledger in memory, writes to disk, commits, and pushes to Git."""
        self.repo_dir.mkdir(parents=True, exist_ok=True)
        sops_config = self.repo_dir / ".sops.yaml"

        if not sops_config.exists():
            console.print("[bold yellow].sops.yaml missing. Initializing environment...[/bold yellow]")
            ensure_sops_config()

        raw_yaml = yaml.dump(data, default_flow_style=False)

        process = subprocess.Popen(
            ["sops", "--encrypt", "--filename-override", "ledger.enc.yaml", "/dev/stdin"],
            cwd=self.repo_dir,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            env=self._get_env()
        )
        encrypted_out, err = process.communicate(input=raw_yaml)

        if process.returncode != 0:
            console.print(f"[bold red]SOPS Encryption Error:[bold red] {err.strip()}")
            raise typer.Exit(1)

        with open(self.ledger_path, "w") as f:
            f.write(encrypted_out)

        if (self.repo_dir / ".git").exists():
            try:
                self._run_cmd(["git", "add", str(self.ledger_path)])
                self._run_cmd(["git", "add", ".sops.yaml"])
                self._run_cmd(["git", "commit", "-m", commit_msg])
                self._run_cmd(["git", "push", "origin", "main"])
                console.print("[dim green]Synced changes with remote Git repo.[/dim green]")
            except Exception as e:
                console.print(f"[dim yellow]Notice: Git push skipped/failed: {e}[/dim yellow]")

ledger_mgr = GitEncryptedLedger(REPO_DIR, LEDGER_PATH)

def load_ledger() -> dict:
    return ledger_mgr.load()

def save_ledger(data: dict, action: str = "Update hwkey ledger"):
    ledger_mgr.save(data, commit_msg=action)

# ----------------------------------------------------------------------
# Setup Helpers & Local Age Key Utilities
# ----------------------------------------------------------------------

def get_local_age_pubkey() -> Optional[str]:
    """Reads the active local Age public key from ~/.config/sops/age/keys.txt."""
    key_file = Path.home() / ".config" / "sops" / "age" / "keys.txt"
    if key_file.exists():
        with open(key_file, "r") as f:
            for line in f:
                if line.startswith("# public key:"):
                    return line.split(":")[-1].strip()
    return None

def ensure_sops_config() -> List[str]:
    """Ensures a local Age key exists and writes a valid .sops.yaml file."""
    age_dir = Path.home() / ".config" / "sops" / "age"
    age_dir.mkdir(parents=True, exist_ok=True)
    key_file = age_dir / "keys.txt"
    recipients: List[str] = []

    local_pub = get_local_age_pubkey()
    if local_pub:
        recipients.append(local_pub)

    if not recipients:
        console.print("[bold cyan]Generating local Age encryption key...[/bold cyan]")
        try:
            res = subprocess.run(
                ["age-keygen", "-o", str(key_file)],
                capture_output=True, text=True, check=True,
                env=GitEncryptedLedger._get_env()
            )
            for line in res.stderr.splitlines():
                if "Public key:" in line:
                    pub = line.split(":")[-1].strip()
                    recipients.append(pub)
                    console.print(f"[bold green]✔ Generated software Age key: {pub}[/bold green]")
        except (subprocess.CalledProcessError, FileNotFoundError):
            console.print("[bold red]Error: 'age-keygen' tool not found. Run ./install.sh first.[/bold red]")
            raise typer.Exit(1)

    age_list_formatted = "\n".join([f"      - {r}" for r in recipients])
    sops_content = f"creation_rules:\n  - path_regex: ledger\\.enc\\.yaml$\n    age:\n{age_list_formatted}\n"

    sops_config = REPO_DIR / ".sops.yaml"
    REPO_DIR.mkdir(parents=True, exist_ok=True)
    with open(sops_config, "w") as f:
        f.write(sops_content)

    return recipients

@app.command()
def init(
    git_url: Optional[str] = typer.Option(None, "--git-url", "-g", help="Remote Git repository URL")
):
    """Initialize the local ledger repository, provision Age keys, and configure SOPS encryption."""
    recipients = ensure_sops_config()

    if typer.confirm("Would you like to add a SECOND Age public key recipient for backup?", default=False):
        backup_pub = typer.prompt("Enter backup Age public key (starts with age1...)").strip()
        recipients.append(backup_pub)
        
        age_list_formatted = "\n".join([f"      - {r}" for r in recipients])
        sops_content = f"creation_rules:\n  - path_regex: ledger\\.enc\\.yaml$\n    age:\n{age_list_formatted}\n"
        with open(REPO_DIR / ".sops.yaml", "w") as f:
            f.write(sops_content)

    if not (REPO_DIR / ".git").exists():
        subprocess.run(["git", "init", "-b", "main"], cwd=REPO_DIR, check=True, env=GitEncryptedLedger._get_env())
        console.print("[bold green]✔ Initialized local Git repository.[/bold green]")

    console.print(f"[bold green]✔ Configured SOPS encryption with {len(recipients)} recipient key(s).[/bold green]")

    if git_url:
        set_remote(git_url)

@app.command("set-remote")
def set_remote(
    git_url: str = typer.Argument(..., help="Remote Git URL (e.g. git@github.com:user/hwkey-ledger.git)"),
    user: Optional[str] = typer.Option(None, "--user", "-u", help="Remote user associated with this repository")
):
    """Configure or update the remote Git repository URL."""
    if not (REPO_DIR / ".git").exists():
        subprocess.run(["git", "init", "-b", "main"], cwd=REPO_DIR, check=True, env=GitEncryptedLedger._get_env())

    res = subprocess.run(["git", "remote", "get-url", "origin"], cwd=REPO_DIR, capture_output=True, text=True, env=GitEncryptedLedger._get_env())
    if res.returncode == 0:
        subprocess.run(["git", "remote", "set-url", "origin", git_url], cwd=REPO_DIR, check=True, env=GitEncryptedLedger._get_env())
    else:
        subprocess.run(["git", "remote", "add", "origin", git_url], cwd=REPO_DIR, check=True, env=GitEncryptedLedger._get_env())

    msg = f"[bold green]✔ Git remote 'origin' set to: {git_url}[/bold green]"
    if user:
        msg += f" [dim](Remote user: {user})[/dim]"
    console.print(msg)

@app.command("show-remotes")
def show_remotes():
    """Show registered remote servers known to the ledger."""
    ledger = load_ledger()
    hosts = ledger.get("hosts", {})

    if not hosts:
        console.print("[bold yellow]No remote hosts registered in the ledger.[/bold yellow]")
        return

    table = Table(title="Registered Remote Hosts")
    table.add_column("Alias / Name", style="cyan")
    table.add_column("Hostname / IP", style="magenta")
    table.add_column("User", style="yellow")
    table.add_column("Port", style="blue")
    table.add_column("Deployed Keys", style="green")

    for alias, host_info in hosts.items():
        deployed_keys = ", ".join(host_info.get("deployed_keys", [])) or "None"
        table.add_row(
            alias,
            host_info.get("hostname", "N/A"),
            host_info.get("user", "N/A"),
            str(host_info.get("port", 22)),
            deployed_keys
        )

    console.print(table)

