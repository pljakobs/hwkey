# Device Management
# ----------------------------------------------------------------------

def get_physical_usb_keys() -> list:
    """Scans USB HID bus directly for FIDO2 hardware devices safely."""
    devices = []
    for dev in CtapHidDevice.list_devices():
        desc = getattr(dev, "descriptor", dev)
        product_name = getattr(desc, "product_name", "Security Key")

        vid = getattr(desc, "vid", getattr(dev, "vid", 0))
        pid = getattr(desc, "pid", getattr(dev, "pid", 0))
        path = getattr(dev, "path", getattr(desc, "path", "unknown"))

        if any(name.lower() in str(product_name).lower() for name in ["yubikey", "security key"]):
            devices.append({
                "product_name": product_name,
                "vendor_id": hex(vid) if isinstance(vid, int) else str(vid),
                "product_id": hex(pid) if isinstance(pid, int) else str(pid),
                "path": str(path)
            })
    return devices

def scan_attached_yubikeys() -> list:
    """Detects connected USB FIDO2 keys and pulls resident keys using OpenSSH."""
    physical_devs = get_physical_usb_keys()
    if not physical_devs:
        console.print("[bold red]No physical FIDO2 USB devices found![/bold red]")
        return []

    console.print(f"[bold cyan]Found {len(physical_devs)} physical hardware key(s):[/bold cyan]")
    for dev in physical_devs:
        console.print(f"  • {dev['product_name']} (VID: {dev['vendor_id']} PID: {dev['product_id']})")

    discovered_keys = []

    with tempfile.TemporaryDirectory() as tmpdir:
        try:
            subprocess.run(
                ["ssh-keygen", "-K"],
                cwd=tmpdir,
                capture_output=True,
                text=True,
                check=True,
                env={"PATH": ENV_PATH}
            )

            for key_file in Path(tmpdir).glob("*.pub"):
                with open(key_file, "r") as f:
                    pubkey_content = f.read().strip()
                    discovered_keys.append({
                        "file_name": key_file.name,
                        "public_key": pubkey_content
                    })

        except subprocess.CalledProcessError:
            console.print("[bold yellow]Note:[bold yellow] 'ssh-keygen -K' found no pre-existing resident keys.")

    return discovered_keys

@app.command("add-sops-key")
def add_sops_key(
    age_pubkey: str = typer.Argument(..., help="New Age recipient public key (starts with age1...)")
):
    """Add a new Age recipient public key to SOPS configuration and re-encrypt the ledger."""
    sops_config = REPO_DIR / ".sops.yaml"
    if not sops_config.exists():
        console.print("[bold red]Error: .sops.yaml missing. Run 'hwkey init' first.[/bold red]")
        raise typer.Exit(1)

    clean_key = age_pubkey.strip()
    if not clean_key.startswith("age1"):
        console.print("[bold red]Invalid key format. Age public keys must start with 'age1'.[/bold red]")
        raise typer.Exit(1)

    with open(sops_config, "r") as f:
        config_data = yaml.safe_load(f) or {}

    # Extract existing recipient list
    rules = config_data.get("creation_rules", [{}])[0]
    existing_age = rules.get("age", [])

    if isinstance(existing_age, str):
        existing_age = [k.strip() for k in existing_age.split(",") if k.strip()]

    if clean_key in existing_age:
        console.print(f"[bold yellow]Age key {clean_key[:15]}... is already configured.[/bold yellow]")
        return

    existing_age.append(clean_key)
    rules["age"] = existing_age
    config_data["creation_rules"] = [rules]

    # Save updated .sops.yaml
    with open(sops_config, "w") as f:
        yaml.dump(config_data, f, default_flow_style=False)

    console.print(f"[bold green]✔ Added recipient {clean_key[:15]}... to .sops.yaml[/bold green]")

    # Re-encrypt ledger.enc.yaml if it exists
    if LEDGER_PATH.exists():
        try:
            res = subprocess.run(
                ["sops", "updatekeys", "-y", str(LEDGER_PATH)],
                cwd=REPO_DIR,
                capture_output=True,
                text=True,
                env={"PATH": ENV_PATH}
            )
            if res.returncode != 0:
                console.print(f"[bold red]SOPS updatekeys failed:[bold red] {res.stderr.strip()}")
                raise typer.Exit(1)

            console.print("[dim green]✔ Re-encrypted ledger.enc.yaml with updated recipient list.[/dim green]")
        except Exception as e:
            console.print(f"[bold red]Failed to update SOPS keys:[bold red] {e}")
            raise typer.Exit(1)

    # Sync changes to Git
    if (REPO_DIR / ".git").exists():
        try:
            subprocess.run(["git", "add", ".sops.yaml", str(LEDGER_PATH)], cwd=REPO_DIR, check=True, env={"PATH": ENV_PATH})
            subprocess.run(["git", "commit", "-m", f"Add SOPS recipient {clean_key[:12]}"], cwd=REPO_DIR, check=True, env={"PATH": ENV_PATH})
            subprocess.run(["git", "push", "origin", "main"], cwd=REPO_DIR, check=True, env={"PATH": ENV_PATH})
            console.print("[dim green]✔ Committed and pushed SOPS configuration to remote Git.[/dim green]")
        except Exception as e:
            console.print(f"[dim yellow]Notice: Git push skipped/failed: {e}[/dim yellow]")

# ----------------------------------------------------------------------
# SSH Engine (Atomic Remote File Manipulation)
# ----------------------------------------------------------------------

def update_remote_authorized_keys(
    host_info: dict, 
    keys_to_add: List[str], 
    keys_to_remove: List[str]
) -> bool:
    """Connects via Paramiko SFTP and updates ~/.ssh/authorized_keys atomically."""
    hostname = host_info["hostname"]
    port = host_info.get("port", 22)
    user = host_info.get("user", os.getlogin())

    client = paramiko.SSHClient()
    client.set_missing_host_key_policy(paramiko.AutoAddPolicy())

    try:
        console.print(f"[bold blue]Connecting to {user}@{hostname}:{port}...[/bold blue]")
        client.connect(hostname=hostname, port=port, username=user, timeout=10)
        sftp = client.open_sftp()

        auth_keys_path = ".ssh/authorized_keys"
        remote_keys = []
        
        try:
            with sftp.open(auth_keys_path, "r") as f:
                remote_keys = [line.strip() for line in f.readlines() if line.strip()]
        except FileNotFoundError:
            try:
                sftp.mkdir(".ssh")
            except IOError:
                pass

        updated_keys = [k for k in remote_keys if k not in keys_to_remove]
        for k in keys_to_add:
            if k not in updated_keys:
                updated_keys.append(k)

        temp_remote = f".ssh/authorized_keys.tmp.{os.urandom(4).hex()}"
        with sftp.open(temp_remote, "w") as f:
            f.write("\n".join(updated_keys) + "\n")
        
        sftp.chmod(temp_remote, 0o600)
        sftp.posix_rename(temp_remote, auth_keys_path)
        
        sftp.close()
        client.close()
        console.print(f"[bold green]✔ Successfully updated keys on {hostname}[/bold green]")
        return True

    except Exception as e:
        console.print(f"[bold red]✖ Failed on {hostname}: {e}[/bold red]")
        return False

