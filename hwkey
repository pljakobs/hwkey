@host_app.command("add")
def register_host(
    hostname: str = typer.Argument(..., help="IP or FQDN of host"),
    alias: Optional[str] = typer.Option(None, "--alias", "-a", help="Optional alias for the host"),
    user: str = typer.Option(os.getlogin(), "--user", "-u", help="Remote SSH user"),
    port: int = typer.Option(22, "--port", "-p", help="SSH port")
):
    """Register a target server host entry and deploy all active hardware keys to it."""
    ledger = load_ledger()
    if not ledger.get("keys"):
        console.print("[bold red]No hardware keys registered in ledger yet! Run 'key scan' or 'key add' first.[/bold red]")
        raise typer.Exit(1)

    host_alias = alias if alias else hostname
    host_info = {
        "alias": host_alias,
        "hostname": hostname,
        "user": user,
        "port": port,
        "deployed_keys": list(ledger["keys"].keys())
    }
    keys_to_deploy = [k_info["public_key"] for k_info in ledger["keys"].values()]

    success = update_remote_authorized_keys(host_info, keys_to_add=keys_to_deploy, keys_to_remove=[])
    
    if success:
        hosts = ledger.setdefault("hosts", [])
        ledger["hosts"] = [h for h in hosts if not (h.get("alias") == host_alias and h.get("user") == user)]
        ledger["hosts"].append(host_info)
        save_ledger(ledger, action=f"Register host {user}@{host_alias}")

@host_app.command("list")
def list_hosts():
    """List all registered SSH target hosts in the encrypted ledger."""
    ledger = load_ledger()
    hosts = ledger.get("hosts", [])

    if not hosts:
        console.print("[bold yellow]No target hosts registered in the ledger.[/bold yellow]")
        return

    table = Table(title="Registered Remote Target Hosts")
    table.add_column("Alias / Name", style="cyan")
    table.add_column("Hostname / IP", style="magenta")
    table.add_column("User", style="yellow")
    table.add_column("Port", style="blue")
    table.add_column("Deployed Key Aliases", style="green")

    for host_info in hosts:
        deployed_keys = ", ".join(host_info.get("deployed_keys", [])) or "None"
        table.add_row(
            host_info.get("alias", "N/A"),
            host_info.get("hostname", "N/A"),
            host_info.get("user", "N/A"),
            str(host_info.get("port", 22)),
            deployed_keys
        )

    console.print(table)

@host_app.command("remove")
def remove_host(
    alias_or_host: str = typer.Argument(..., help="Host alias or hostname to remove"),
    user: Optional[str] = typer.Option(None, "--user", "-u", help="Specific user entry to target if multiple exist")
):
    """Remove a target host entry from the encrypted ledger."""
    ledger = load_ledger()
    hosts = ledger.get("hosts", [])
    
    matching_hosts = [
        h for h in hosts 
        if (h.get("alias") == alias_or_host or h.get("hostname") == alias_or_host)
        and (user is None or h.get("user") == user)
    ]

    if not matching_hosts:
        console.print(f"[bold red]Host entry '{alias_or_host}' not found in ledger.[/bold red]")
        raise typer.Exit(1)

    ledger["hosts"] = [h for h in hosts if h not in matching_hosts]
    save_ledger(ledger, action=f"Remove host {alias_or_host}")
    console.print(f"[bold green]✔ Successfully removed host '{alias_or_host}' from ledger.[/bold green]")

