@app.command()
def enroll(
    key_id: str = typer.Argument(..., help="Identifier for the YubiKey (e.g. yubi_primary)"),
    pubkey: str = typer.Argument(..., help="The public key string")
):
    """Enroll a new hardware key into the ledger."""
    ledger = load_ledger()
    ledger["keys"][key_id] = {"public_key": pubkey.strip()}
    save_ledger(ledger, action=f"Enroll key {key_id}")
    console.print(f"[bold green]Enrolled hardware key '{key_id}' into encrypted ledger.[/bold green]")

@app.command()
def register(
    hostname: str = typer.Argument(..., help="IP or FQDN of host"),
    alias: Optional[str] = typer.Option(None, "--alias", "-a", help="Optional alias for the host"),
    user: str = typer.Option(os.getlogin(), "--user", "-u", help="Remote SSH user"),
    port: int = typer.Option(22, "--port", "-p", help="SSH port")
):
    """Register a target server and deploy all ledger keys to it."""
    ledger = load_ledger()
    if not ledger.get("keys"):
        console.print("[bold red]No keys enrolled in ledger yet! Run 'hwkey scan' or 'hwkey enroll' first.[/bold red]")
        raise typer.Exit(1)

    host_alias = alias if alias else hostname
    host_info = {"hostname": hostname, "user": user, "port": port}
    keys_to_deploy = [k_info["public_key"] for k_info in ledger["keys"].values()]

    success = update_remote_authorized_keys(host_info, keys_to_add=keys_to_deploy, keys_to_remove=[])
    
    if success:
        ledger["hosts"][host_alias] = {
            **host_info,
            "deployed_keys": list(ledger["keys"].keys())
        }
        save_ledger(ledger, action=f"Register host {host_alias}")

@app.command("show-keys")
def show_keys():
    """Show keys known to the ledger and where they are deployed."""
    ledger = load_ledger()
    table = Table(title="Encrypted Hardware Key Ledger")
    table.add_column("Key Alias", style="cyan")
    table.add_column("Public Key Excerpt", style="magenta")
    table.add_column("Deployed Hosts", style="green")

    for key_id, data in ledger.get("keys", {}).items():
        pub = data["public_key"]
        excerpt = f"{pub[:20]}...{pub[-15:]}" if len(pub) > 35 else pub
        hosts = [h for h, h_data in ledger.get("hosts", {}).items() if key_id in h_data.get("deployed_keys", [])]
        table.add_row(key_id, excerpt, ", ".join(hosts) if hosts else "None")

    console.print(table)

@app.command()
def revoke(key_id: str = typer.Argument(..., help="Key identifier to revoke")):
    """Revoke a hardware key from all hosts holding it."""
    ledger = load_ledger()
    if key_id not in ledger.get("keys", {}):
        console.print(f"[bold red]Key '{key_id}' not found in ledger.[/bold red]")
        raise typer.Exit(1)

    target_pubkey = ledger["keys"][key_id]["public_key"]

    for alias, host_info in ledger.get("hosts", {}).items():
        if key_id in host_info.get("deployed_keys", []):
            success = update_remote_authorized_keys(host_info, keys_to_add=[], keys_to_remove=[target_pubkey])
            if success:
                host_info["deployed_keys"].remove(key_id)

    save_ledger(ledger, action=f"Revoke key {key_id}")
    console.print(f"[bold green]Revocation completed for '{key_id}'.[/bold green]")

@app.command()
def rotate(
    old_key_id: str = typer.Argument(..., help="Key ID being replaced"),
    new_key_id: str = typer.Argument(..., help="New key ID"),
    new_pubkey: str = typer.Argument(..., help="New public key string")
):
    """Regenerate/replace a key in the ledger and update all servers holding the old key."""
    ledger = load_ledger()
    if old_key_id not in ledger.get("keys", {}):
        console.print(f"[bold red]Key '{old_key_id}' not found.[/bold red]")
        raise typer.Exit(1)

    old_pubkey = ledger["keys"][old_key_id]["public_key"]
    ledger["keys"][new_key_id] = {"public_key": new_pubkey.strip()}

    for alias, host_info in ledger.get("hosts", {}).items():
        if old_key_id in host_info.get("deployed_keys", []):
            success = update_remote_authorized_keys(
                host_info, 
                keys_to_add=[new_pubkey.strip()], 
                keys_to_remove=[old_pubkey]
            )
            if success:
                host_info["deployed_keys"].remove(old_key_id)
                host_info["deployed_keys"].append(new_key_id)

    del ledger["keys"][old_key_id]
    save_ledger(ledger, action=f"Rotate key {old_key_id} to {new_key_id}")
    console.print(f"[bold green]Rotated '{old_key_id}' to '{new_key_id}'.[/bold green]")

@app.command()
def remove(key_id: str = typer.Argument(..., help="Key ID to remove and revoke")):
    """Remove a hardware key storage device and revoke its public key everywhere."""
    revoke(key_id)
    ledger = load_ledger()
    if key_id in ledger.get("keys", {}):
        del ledger["keys"][key_id]
        save_ledger(ledger, action=f"Remove key {key_id}")
    console.print(f"[bold green]Key '{key_id}' removed from ledger completely.[/bold green]")

@app.command()
def scan():
    """Scan attached YubiKeys, discover physical devices, and enroll SSH resident keys."""
    console.print("[bold blue]Scanning USB bus for physical hardware keys...[/bold blue]")
    keys = scan_attached_yubikeys()

    if not keys:
        if typer.confirm("Would you like to generate a new resident SSH key on the attached YubiKey?"):
            alias = typer.prompt("Enter a label for this key (e.g., yubi_primary)")

            with tempfile.TemporaryDirectory() as tmpdir:
                key_path = Path(tmpdir) / "id_ed25519_sk"
                subprocess.run([
                    "ssh-keygen", "-t", "ed25519-sk",
                    "-O", "resident",
                    "-C", alias,
                    "-f", str(key_path)
                 ], check=True, env={"PATH": ENV_PATH})

                pubkey_path = Path(str(key_path) + ".pub")
                with open(pubkey_path, "r") as f:
                    pubkey = f.read().strip()

            ledger = load_ledger()
            ledger["keys"][alias] = {"public_key": pubkey}
            save_ledger(ledger, action=f"Scan & enroll {alias}")
            console.print(f"[bold green]✔ Successfully generated & enrolled '{alias}'![/bold green]")
        return

    ledger = load_ledger()
    for idx, item in enumerate(keys):
        auto_alias = f"yubi_hardware_{idx+1}"
        ledger["keys"][auto_alias] = {"public_key": item["public_key"]}
        console.print(f"[bold green]✔ Enrolled '{auto_alias}' into ledger[/bold green]")

    save_ledger(ledger, action="Scan & enroll attached hardware keys")

