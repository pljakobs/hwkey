@key_app.command("add")
def register_key(
    key_id: str = typer.Argument(..., help="Identifier for the key (e.g. yubi_primary)"),
    pubkey: str = typer.Argument(..., help="The SSH public key string")
):
    """Manually register an existing hardware SSH key into the ledger."""
    ledger = load_ledger()
    ledger["keys"][key_id] = {"public_key": pubkey.strip()}
    save_ledger(ledger, action=f"Register key {key_id}")
    console.print(f"[bold green]Registered hardware key '{key_id}' into encrypted ledger.[/bold green]")

@key_app.command("enroll")
def enroll_key(
    key_id: str = typer.Option(None, "--id", "-i", help="Unique ledger identifier for the new key"),
    application: str = typer.Option("hwkey", "--application", "-a", help="Key comment/application tag")
):
    """Generate a brand-new resident SSH key on the physical YubiKey and record it in the ledger."""
    console.print("[bold blue]Generating new resident credential on physical token...[/bold blue]")

    alias = key_id or typer.prompt("Enter a unique identifier for this new key (e.g., yubi_primary)")

    ledger = load_ledger()
    if alias in ledger.get("keys", {}):
        console.print(f"[bold red]Key ID '{alias}' already exists in ledger. Use 'key rotate' or choose another ID.[/bold red]")
        raise typer.Exit(1)

    with tempfile.TemporaryDirectory() as tmpdir:
        key_path = Path(tmpdir) / "id_ed25519_sk"
        try:
            subprocess.run([
                "ssh-keygen", "-t", "ed25519-sk",
                "-O", "resident",
                "-C", f"{alias} ({application})",
                "-f", str(key_path)
            ], check=True, env=GitEncryptedLedger._get_env())

            with open(Path(str(key_path) + ".pub"), "r") as f:
                pubkey = f.read().strip()

        except subprocess.CalledProcessError:
            console.print("[bold red]Failed to create resident key on hardware device. Ensure key is connected and PIN/touch is supplied.[/bold red]")
            raise typer.Exit(1)

    ledger["keys"][alias] = {"public_key": pubkey}
    save_ledger(ledger, action=f"Enroll resident key {alias}")
    console.print(f"[bold green]✔ Successfully created resident key on hardware and registered '{alias}' in ledger![/bold green]")

@key_app.command("stub")
def generate_stubs(
    output_dir: Path = typer.Option(
        Path.home() / ".ssh", "--out-dir", "-o", help="Directory where SSH key stubs should be generated"
    )
):
    """Extract resident key handles from the attached hardware key into local SSH stubs."""
    console.print(f"[bold blue]Extracting local key handles from attached YubiKey into {output_dir}...[/bold blue]")
    output_dir.mkdir(parents=True, exist_ok=True)

    try:
        res = subprocess.run(
            ["ssh-keygen", "-K"],
            cwd=output_dir,
            capture_output=True,
            text=True,
            check=True,
            env=GitEncryptedLedger._get_env()
        )

        extracted_files = list(output_dir.glob("id_*_rk*"))
        if not extracted_files:
            console.print("[bold yellow]No resident keys found on the attached token.[/bold yellow]")
            return

        console.print(f"[bold green]✔ Extracted key stub(s) successfully:[/bold green]")
        for stub in output_dir.glob("id_*_rk*.pub"):
            console.print(f"  • {stub.with_suffix('').name} ({stub.name})")

    except subprocess.CalledProcessError as e:
        console.print(f"[bold red]Failed to extract resident keys: {e.stderr.strip()}[/bold red]")
        raise typer.Exit(1)

@key_app.command("scan")
def scan_keys():
    """Scan attached YubiKeys and sync existing hardware resident keys into the ledger."""
    console.print("[bold blue]Scanning USB bus for physical hardware keys...[/bold blue]")

    devices = []
    for dev in CtapHidDevice.list_devices():
        desc = getattr(dev, "descriptor", dev)
        product_name = getattr(desc, "product_name", "Security Key")
        vid = getattr(desc, "vid", getattr(dev, "vid", 0))
        pid = getattr(desc, "pid", getattr(dev, "pid", 0))
        path = getattr(dev, "path", getattr(desc, "path", "unknown"))

        if any(name.lower() in str(product_name).lower() for name in ["yubikey", "security key"]):
            devices.append({
                "product_name": product_name,
                "vendor_id": hex(vid) if isinstance(vid, int) else str(vid),
                "product_id": hex(pid) if isinstance(pid, int) else str(pid),
                "path": str(path)
            })

    if not devices:
        console.print("[bold red]No physical FIDO2 USB devices found![/bold red]")
        return

    console.print(f"[bold cyan]Found {len(devices)} physical hardware key device(s):[/bold cyan]")
    for dev in devices:
        console.print(f"  • {dev['product_name']} (VID: {dev['vendor_id']} PID: {dev['product_id']})")

    discovered_keys = []
    with tempfile.TemporaryDirectory() as tmpdir:
        try:
            subprocess.run(
                ["ssh-keygen", "-K", "-N", ""],
                cwd=tmpdir,
                capture_output=True,
                text=True,
                check=True,
                env=GitEncryptedLedger._get_env()
            )
            for key_file in Path(tmpdir).glob("*.pub"):
                with open(key_file, "r") as f:
                    discovered_keys.append({
                        "file_name": key_file.name,
                        "public_key": f.read().strip()
                    })
        except subprocess.CalledProcessError:
            console.print("[bold yellow]Note: 'ssh-keygen -K' found no pre-existing resident keys on token.[/bold yellow]")

    if not discovered_keys:
        console.print("[dim yellow]No resident keys to sync. Use 'hwkey key enroll' if you wish to provision a new key.[/dim yellow]")
        return

    ledger = load_ledger()
    updated = False

    for item in discovered_keys:
        pub = item["public_key"]
        # Check if public key is already registered in ledger
        existing_alias = next((k for k, v in ledger.get("keys", {}).items() if v.get("public_key") == pub), None)

        if existing_alias:
            console.print(f"[dim green]• Key matching '{existing_alias}' is already registered.[/dim green]")
        else:
            auto_alias = typer.prompt(f"Found new resident key ({pub[:15]}...). Enter alias", default=f"yubi_key_{len(ledger.get('keys', {})) + 1}")
            ledger["keys"][auto_alias] = {"public_key": pub}
            console.print(f"[bold green]✔ Enrolled '{auto_alias}' into ledger[/bold green]")
            updated = True

    if updated:
        save_ledger(ledger, action="Scan & sync attached hardware keys")

@key_app.command("list")
def list_keys():
    """List all hardware keys stored in ledger and their deployment targets."""
    ledger = load_ledger()
    table = Table(title="Encrypted Hardware Key Ledger")
    table.add_column("Key Alias", style="cyan")
    table.add_column("Public Key Excerpt", style="magenta")
    table.add_column("Deployed Target Hosts", style="green")

    for key_id, data in ledger.get("keys", {}).items():
        pub = data["public_key"]
        excerpt = f"{pub[:20]}...{pub[-15:]}" if len(pub) > 35 else pub
        hosts = [
            f"{h.get('user')}@{h.get('alias', h.get('hostname'))}"
            for h in ledger.get("hosts", [])
            if key_id in h.get("deployed_keys", [])
        ]
        table.add_row(key_id, excerpt, ", ".join(hosts) if hosts else "None")

    console.print(table)

@key_app.command("rotate")
def rotate_key(
    old_key_id: str = typer.Argument(..., help="Key ID being replaced"),
    new_key_id: str = typer.Argument(..., help="New key ID"),
    new_pubkey: str = typer.Argument(..., help="New public key string")
):
    """Rotate an SSH key on hardware, propagating the new key to reachable target hosts."""
    console.print("[bold yellow]⚠️ WARNING: DANGER ZONE ⚠️[/bold yellow]")
    console.print("[yellow]Rotating a hardware key requires remote SSH connectivity to update authorized_keys.[/yellow]")
    console.print("[yellow]Any host unreachable during this operation will lose access for the old key![/yellow]\n")

    if not typer.confirm("Do you wish to proceed with key rotation?"):
        raise typer.Exit(0)

    ledger = load_ledger()
    if old_key_id not in ledger.get("keys", {}):
        console.print(f"[bold red]Key '{old_key_id}' not found in ledger.[/bold red]")
        raise typer.Exit(1)

    old_pubkey = ledger["keys"][old_key_id]["public_key"]
    ledger["keys"][new_key_id] = {"public_key": new_pubkey.strip()}

    failed_hosts = []
    for host_info in ledger.get("hosts", []):
        if old_key_id in host_info.get("deployed_keys", []):
            success = update_remote_authorized_keys(
                host_info,
                keys_to_add=[new_pubkey.strip()],
                keys_to_remove=[old_pubkey]
            )
            if success:
                host_info["deployed_keys"].remove(old_key_id)
                host_info["deployed_keys"].append(new_key_id)
            else:
                failed_hosts.append(host_info.get("alias", host_info.get("hostname")))

    del ledger["keys"][old_key_id]
    save_ledger(ledger, action=f"Rotate key {old_key_id} to {new_key_id}")

    if failed_hosts:
        console.print(f"[bold red]Key rotation finished with warnings. Could not update unreachable hosts: {', '.join(failed_hosts)}[/bold red]")
    else:
        console.print(f"[bold green]✔ Successfully rotated '{old_key_id}' to '{new_key_id}' across all target hosts.[/bold green]")

@key_app.command("revoke")
def revoke_key(
    key_id: str = typer.Argument(..., help="Hardware key identifier to retire and revoke")
):
    """Retire a hardware key and revoke its SSH key across all registered target hosts."""
    ledger = load_ledger()
    if key_id not in ledger.get("keys", {}):
        console.print(f"[bold red]Key '{key_id}' not found in ledger.[/bold red]")
        raise typer.Exit(1)

    target_pubkey = ledger["keys"][key_id]["public_key"]

    for host_info in ledger.get("hosts", []):
        if key_id in host_info.get("deployed_keys", []):
            success = update_remote_authorized_keys(host_info, keys_to_add=[], keys_to_remove=[target_pubkey])
            if success:
                host_info["deployed_keys"].remove(key_id)

    del ledger["keys"][key_id]
    save_ledger(ledger, action=f"Revoke key {key_id}")
    console.print(f"[bold green]✔ Key '{key_id}' retired and revoked across all reachable hosts.[/bold green]")


