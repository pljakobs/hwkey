def get_local_age_pubkey() -> Optional[str]:
    """Reads the active local Age public key from ~/.config/sops/age/keys.txt."""
    key_file = Path.home() / ".config" / "sops" / "age" / "keys.txt"
    if key_file.exists():
        with open(key_file, "r") as f:
            for line in f:
                if line.startswith("# public key:"):
                    return line.split(":")[-1].strip()
    return None

def ensure_sops_config() -> List[str]:
    """Ensures a local Age key exists and writes a valid .sops.yaml file."""
    age_dir = Path.home() / ".config" / "sops" / "age"
    age_dir.mkdir(parents=True, exist_ok=True)
    key_file = age_dir / "keys.txt"
    recipients: List[str] = []

    local_pub = get_local_age_pubkey()
    if local_pub:
        recipients.append(local_pub)

    if not recipients:
        console.print("[bold cyan]Generating local Age encryption key...[/bold cyan]")
        try:
            res = subprocess.run(
                ["age-keygen", "-o", str(key_file)],
                capture_output=True, text=True, check=True,
                env=GitEncryptedLedger._get_env()
            )
            for line in res.stderr.splitlines():
                if "Public key:" in line:
                    pub = line.split(":")[-1].strip()
                    recipients.append(pub)
                    console.print(f"[bold green]✔ Generated software Age key: {pub}[/bold green]")
        except (subprocess.CalledProcessError, FileNotFoundError):
            console.print("[bold red]Error: 'age-keygen' tool not found. Run installation first.[/bold red]")
            raise typer.Exit(1)

    age_list_formatted = "\n".join([f"      - {r}" for r in recipients])
    sops_content = f"creation_rules:\n  - path_regex: ledger\\.enc\\.yaml$\n    age:\n{age_list_formatted}\n"

    sops_config = REPO_DIR / ".sops.yaml"
    REPO_DIR.mkdir(parents=True, exist_ok=True)
    with open(sops_config, "w") as f:
        f.write(sops_content)

    return recipients

def ensure_yubikey_pin(serial: Optional[str] = None):
    """Checks if a FIDO PIN is set on the specified YubiKey and prompts to set one if missing."""
    try:
        cmd = ["ykman"]
        if serial:
            cmd.extend(["--device", serial])
        cmd.extend(["fido", "info"])

        res = subprocess.run(
            cmd,
            input="\n",  # Send empty newline to bypass any prompt safely
            capture_output=True, text=True, check=True,
            env=GitEncryptedLedger._get_env()
        )

        # Robustly parse output line-by-line to handle varying whitespace formatting
        pin_not_set = False
        for line in res.stdout.splitlines():
            lower_line = line.lower().strip()
            if lower_line.startswith("pin:") and "not set" in lower_line:
                pin_not_set = True
                break

        if pin_not_set:
            target_desc = f" (Serial: {serial})" if serial else ""
            console.print(f"[bold yellow]Notice: No FIDO PIN is set on hardware key{target_desc}.[/bold yellow]")
            if typer.confirm("A PIN is recommended for security. Would you like to set one now?", default=True):
                new_pin = typer.prompt("Enter new FIDO PIN", hide_input=True, confirmation_prompt=True)
                change_cmd = ["ykman"]
                if serial:
                    change_cmd.extend(["--device", serial])
                change_cmd.extend(["fido", "access", "change-pin"])

                subprocess.run(
                    change_cmd,
                    input=f"\n{new_pin}\n{new_pin}\n",
                    capture_output=True, text=True, check=True,
                    env=GitEncryptedLedger._get_env()
                )
                console.print("[bold green]✔ FIDO PIN successfully configured.[/bold green]")
    except (subprocess.CalledProcessError, FileNotFoundError):
        pass

def format_managed_key_line(pubkey: str, key_alias: str) -> str:
    """Appends a hwkey tracking tag to public key entries."""
    clean_pub = pubkey.strip()
    return f"{clean_pub} hwkey:{key_alias}"

def parse_authorized_keys_line(line: str) -> Tuple[str, Optional[str]]:
    """Extracts raw key string and hwkey tag if present."""
    line = line.strip()
    if not line or line.startswith("#"):
        return line, None
    
    parts = line.split()
    managed_alias = None
    for part in parts:
        if part.startswith("hwkey:"):
            managed_alias = part.split(":", 1)[1]
            break
            
    return line, managed_alias

def public_key_identity(pubkey: str) -> str:
    """Return the stable key type and blob, ignoring mutable comments/tags."""
    return " ".join(pubkey.strip().split()[:2])

def ssh_wire_string(value: bytes) -> bytes:
    return struct.pack(">I", len(value)) + value

def openssh_sk_ed25519_public_key(public_key: dict, application: str) -> Optional[str]:
    if public_key.get(3) not in (-8, -19) or public_key.get(-1) != 6:
        return None

    key_material = public_key.get(-2)
    if not isinstance(key_material, bytes) or len(key_material) != 32:
        return None

    key_type = b"sk-ssh-ed25519@openssh.com"
    key_blob = b"".join([
        ssh_wire_string(key_type),
        ssh_wire_string(key_material),
        ssh_wire_string(application.encode()),
    ])
    return f"{key_type.decode()} {base64.b64encode(key_blob).decode()}"

def read_attached_resident_keys_via_fido2() -> List[Dict[str, str]]:
    """Enumerate SSH resident credentials using CTAP credential management."""
    discovered_keys = []

    devices = list(CtapHidDevice.list_devices())
    if not devices:
        return discovered_keys

    pin = typer.prompt("Enter FIDO PIN for credential enumeration", hide_input=True)

    for device_index, device in enumerate(devices, start=1):
        with device:
            ctap = Ctap2(device)
            if not CredentialManagement.is_supported(ctap.info):
                console.print(f"[dim yellow]Device {device_index} does not support credential management enumeration.[/dim yellow]")
                continue

            client_pin = ClientPin(ctap)
            try:
                pin_token = client_pin.get_pin_token(pin, ClientPin.PERMISSION.CREDENTIAL_MGMT)
            except CtapError as e:
                if e.code == CtapError.ERR.PIN_NOT_SET:
                    raise RuntimeError(
                        "FIDO2 PIN is not set on this hardware key. Other YubiKey PINs "
                        "(PIV, OpenPGP, OATH/Yubico Authenticator) do not unlock FIDO2 "
                        "resident SSH credential enumeration. Set it with: ykman fido access change-pin"
                    ) from e
                raise
            credman = CredentialManagement(ctap, client_pin.protocol, pin_token)

            for relying_party in credman.enumerate_rps():
                rp = relying_party.get(CredentialManagement.RESULT.RP, {})
                application = rp.get("id", "")
                if not application.startswith("ssh:"):
                    continue

                rp_id_hash = relying_party.get(CredentialManagement.RESULT.RP_ID_HASH)
                if not rp_id_hash:
                    continue

                for credential in credman.enumerate_creds(rp_id_hash):
                    public_key = credential.get(CredentialManagement.RESULT.PUBLIC_KEY)
                    pubkey = openssh_sk_ed25519_public_key(public_key, application) if public_key else None
                    if not pubkey:
                        continue

                    user = credential.get(CredentialManagement.RESULT.USER, {})
                    file_name = user.get("name") or user.get("displayName") or f"device_{device_index}_ssh_key"
                    discovered_keys.append({
                        "file_name": f"{file_name}.pub",
                        "public_key": pubkey,
                        "identity": public_key_identity(pubkey)
                    })

    return discovered_keys

def read_attached_resident_keys() -> List[Dict[str, str]]:
    """Extract resident SSH public keys from attached hardware tokens."""
    discovered_keys = []
    ssh_keygen_error = None

    with tempfile.TemporaryDirectory() as tmpdir:
        try:
            subprocess.run(
                ["ssh-keygen", "-K", "-N", ""],
                cwd=tmpdir,
                capture_output=True,
                text=True,
                check=True,
                env=GitEncryptedLedger._get_env()
            )
        except subprocess.CalledProcessError as e:
            ssh_keygen_error = e.stderr.strip() or "ssh-keygen failed to read resident keys"
        else:
            for key_file in Path(tmpdir).glob("*.pub"):
                with open(key_file, "r") as f:
                    public_key = f.read().strip()
                discovered_keys.append({
                    "file_name": key_file.name,
                    "public_key": public_key,
                    "identity": public_key_identity(public_key)
                })

    if discovered_keys:
        return discovered_keys

    try:
        fallback_keys = read_attached_resident_keys_via_fido2()
    except Exception as e:
        fallback_error = str(e)
        if ssh_keygen_error:
            raise RuntimeError(f"ssh-keygen failed: {ssh_keygen_error}; FIDO2 fallback failed: {fallback_error}") from e
        raise RuntimeError(f"FIDO2 fallback failed: {fallback_error}") from e

    if fallback_keys:
        if ssh_keygen_error:
            console.print(f"[dim yellow]ssh-keygen resident-key download failed, used FIDO2 credential enumeration instead: {ssh_keygen_error}[/dim yellow]")
        return fallback_keys

    if ssh_keygen_error:
        raise RuntimeError(ssh_keygen_error)

    return []

def extract_resident_identity_file(key_alias: str, ledger: dict, output_dir: Path) -> Path:
    """Extract the resident private-key stub matching a ledger key alias."""
    key_info = ledger.get("keys", {}).get(key_alias)
    if not key_info:
        raise RuntimeError(f"Key '{key_alias}' is not registered in the ledger")

    target_identity = public_key_identity(key_info.get("public_key", ""))
    if not target_identity:
        raise RuntimeError(f"Key '{key_alias}' has no usable public key in the ledger")

    try:
        subprocess.run(
            ["ssh-keygen", "-K", "-N", ""],
            cwd=output_dir,
            check=True,
            env=GitEncryptedLedger._get_env()
        )
    except subprocess.CalledProcessError as e:
        raise RuntimeError(f"Could not extract resident key stubs from active hardware key: {e}") from e

    for pub_path in output_dir.glob("*.pub"):
        with open(pub_path, "r") as f:
            if public_key_identity(f.read()) == target_identity:
                return pub_path.with_suffix("")

    raise RuntimeError(f"Resident key '{key_alias}' was not found on the plugged-in hardware key")

def choose_rollout_auth_key(ledger: dict, keys_to_deploy: List[Tuple[str, str]], auth_key_id: Optional[str]) -> Optional[str]:
    """Select an already deployed ledger key for authenticating rollout."""
    hosts = ledger.get("hosts", [])
    if not hosts:
        return None

    if auth_key_id:
        if auth_key_id not in ledger.get("keys", {}):
            console.print(f"[bold red]Authentication key '{auth_key_id}' is not registered in the ledger.[/bold red]")
            raise typer.Exit(1)
        return auth_key_id

    new_key_aliases = {key_alias for key_alias, _ in keys_to_deploy}
    candidates = [
        key_alias
        for key_alias in ledger.get("keys", {})
        if key_alias not in new_key_aliases
        and any(key_alias in host.get("deployed_keys", []) for host in hosts)
    ]

    if not candidates:
        console.print("[dim yellow]No already-deployed ledger key is available for rollout authentication. Falling back to default SSH auth.[/dim yellow]")
        return None

    console.print("[bold blue]Plug in the active hardware key used for existing server access.[/bold blue]")
    console.print(f"[dim]Available rollout authentication key IDs: {', '.join(candidates)}[/dim]")
    selected = typer.prompt("Ledger key ID to authenticate rollout", default=candidates[0]).strip()
    if selected not in ledger.get("keys", {}):
        console.print(f"[bold red]Authentication key '{selected}' is not registered in the ledger.[/bold red]")
        raise typer.Exit(1)

    return selected

def update_remote_authorized_keys_via_openssh(
    host_info: dict,
    keys_to_add: List[Tuple[str, str]],
    keys_to_remove_aliases: List[str],
    identity_file: Path
) -> bool:
    """Update authorized_keys through OpenSSH so FIDO-backed identities work."""
    hostname = host_info["hostname"]
    port = host_info.get("port", 22)
    user = host_info.get("user", os.getlogin())
    target = f"{user}@{hostname}"
    ssh_cmd = [
        "ssh",
        "-i", str(identity_file),
        "-o", "IdentitiesOnly=yes",
        "-p", str(port),
        target
    ]

    try:
        console.print(f"[bold blue]Connecting to {target}:{port} using {identity_file.name}...[/bold blue]")
        read_res = subprocess.run(
            ssh_cmd + ["test -f .ssh/authorized_keys && cat .ssh/authorized_keys || true"],
            stdout=subprocess.PIPE,
            text=True,
            check=True,
            env=GitEncryptedLedger._get_env()
        )

        retained_lines = []
        for line in read_res.stdout.splitlines():
            raw_line, managed_alias = parse_authorized_keys_line(line)
            if managed_alias and managed_alias in keys_to_remove_aliases:
                continue
            if raw_line:
                retained_lines.append(raw_line)

        for key_alias, key_pubkey in keys_to_add:
            formatted = format_managed_key_line(key_pubkey, key_alias)
            retained_lines = [
                line for line in retained_lines
                if parse_authorized_keys_line(line)[1] != key_alias
            ]
            retained_lines.append(formatted)

        new_content = "\n".join(retained_lines) + "\n"
        write_script = "umask 077; mkdir -p .ssh; tmp=.ssh/authorized_keys.tmp.$$; cat > \"$tmp\" && chmod 600 \"$tmp\" && mv \"$tmp\" .ssh/authorized_keys"
        subprocess.run(
            ssh_cmd + [write_script],
            input=new_content,
            text=True,
            check=True,
            env=GitEncryptedLedger._get_env()
        )

        console.print(f"[bold green]✔ Successfully updated keys on {hostname}[/bold green]")
        return True
    except Exception as e:
        console.print(f"[bold red]✖ Failed on {hostname}: {e}[/bold red]")
        return False

def update_remote_authorized_keys(
    host_info: dict, 
    keys_to_add: List[Tuple[str, str]],  # List of (key_alias, pubkey)
    keys_to_remove_aliases: List[str],
    identity_file: Optional[Path] = None
) -> bool:
    """Connects via Paramiko SFTP and updates ~/.ssh/authorized_keys safely with key tags."""
    if identity_file:
        return update_remote_authorized_keys_via_openssh(
            host_info,
            keys_to_add=keys_to_add,
            keys_to_remove_aliases=keys_to_remove_aliases,
            identity_file=identity_file
        )

    hostname = host_info["hostname"]
    port = host_info.get("port", 22)
    user = host_info.get("user", os.getlogin())

    client = paramiko.SSHClient()
    client.set_missing_host_key_policy(paramiko.AutoAddPolicy())

    try:
        console.print(f"[bold blue]Connecting to {user}@{hostname}:{port}...[/bold blue]")
        client.connect(hostname=hostname, port=port, username=user, timeout=10)
        sftp = client.open_sftp()

        auth_keys_path = ".ssh/authorized_keys"
        existing_lines = []
        
        try:
            with sftp.open(auth_keys_path, "r") as f:
                existing_lines = [line.strip() for line in f.readlines() if line.strip()]
        except FileNotFoundError:
            try:
                sftp.mkdir(".ssh")
            except IOError:
                pass

        # Preserve unmanaged/out-of-band keys and filter removed managed keys
        retained_lines = []
        for line in existing_lines:
            raw_line, managed_alias = parse_authorized_keys_line(line)
            if managed_alias and managed_alias in keys_to_remove_aliases:
                continue
            retained_lines.append(raw_line)

        # Update or add missing managed keys with tags
        for k_alias, k_pubkey in keys_to_add:
            formatted = format_managed_key_line(k_pubkey, k_alias)
            # Remove older references to the same key alias if re-adding
            retained_lines = [
                l for l in retained_lines 
                if parse_authorized_keys_line(l)[1] != k_alias
            ]
            retained_lines.append(formatted)

        temp_remote = f".ssh/authorized_keys.tmp.{os.urandom(4).hex()}"
        with sftp.open(temp_remote, "w") as f:
            f.write("\n".join(retained_lines) + "\n")
        
        sftp.chmod(temp_remote, 0o600)
        sftp.posix_rename(temp_remote, auth_keys_path)
        
        sftp.close()
        client.close()
        console.print(f"[bold green]✔ Successfully updated keys on {hostname}[/bold green]")
        return True

    except Exception as e:
        console.print(f"[bold red]✖ Failed on {hostname}: {e}[/bold red]")
        return False

def deploy_keys_to_registered_hosts(
    ledger: dict,
    keys_to_deploy: List[Tuple[str, str]],
    auth_key_id: Optional[str] = None
) -> List[str]:
    """Deploy newly registered keys to every host already tracked in the ledger."""
    failed_hosts = []
    selected_auth_key = choose_rollout_auth_key(ledger, keys_to_deploy, auth_key_id)

    if selected_auth_key:
        with tempfile.TemporaryDirectory() as tmpdir:
            try:
                identity_file = extract_resident_identity_file(selected_auth_key, ledger, Path(tmpdir))
            except RuntimeError as e:
                console.print(f"[bold red]{e}[/bold red]")
                raise typer.Exit(1)

            for host_info in ledger.get("hosts", []):
                if selected_auth_key not in host_info.get("deployed_keys", []):
                    console.print(
                        f"[dim yellow]Notice: auth key '{selected_auth_key}' is not marked deployed on "
                        f"{host_info.get('alias', host_info.get('hostname', 'unknown'))}; attempting anyway.[/dim yellow]"
                    )
                success = update_remote_authorized_keys(
                    host_info,
                    keys_to_add=keys_to_deploy,
                    keys_to_remove_aliases=[],
                    identity_file=identity_file
                )
                host_alias = host_info.get("alias", host_info.get("hostname", "unknown"))
                if success:
                    deployed_keys = host_info.setdefault("deployed_keys", [])
                    for key_alias, _ in keys_to_deploy:
                        if key_alias not in deployed_keys:
                            deployed_keys.append(key_alias)
                else:
                    failed_hosts.append(host_alias)

        return failed_hosts

    for host_info in ledger.get("hosts", []):
        success = update_remote_authorized_keys(
            host_info,
            keys_to_add=keys_to_deploy,
            keys_to_remove_aliases=[]
        )
        host_alias = host_info.get("alias", host_info.get("hostname", "unknown"))
        if success:
            deployed_keys = host_info.setdefault("deployed_keys", [])
            for key_alias, _ in keys_to_deploy:
                if key_alias not in deployed_keys:
                    deployed_keys.append(key_alias)
        else:
            failed_hosts.append(host_alias)

    return failed_hosts

